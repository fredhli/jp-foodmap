# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Playwright user profile (large, machine-local)
.chrome_profile/

# All raw data stays local — only docs/index.html is committed.
# Uses data/* (not data/) so the !data/attractions.csv exception below
# is reachable; a bare data/ ignore halts traversal at the directory and
# silently swallows nested re-includes.
data/*
!data/attractions.csv
!data/favorites_builtin.json
# Hand-written translation tables for the static UI (Simplified Chinese →
# English / Japanese). Source, not scraped data — version them alongside
# map.py so a fresh clone rebuilds with the same translations baked in.
!data/i18n/
!data/i18n/*.json

# Editor / tool state
.claude/
.idea/
.vscode/

# Wrangler local dev state
.wrangler/

# Local config (Gist ID, etc) — never commit
config.json
.env
.env.*
!.env.example

# Claude Code project context — kept local
CLAUDE.md

# One-shot / ad-hoc scripts and dev helpers that don't affect the build
# output. Kept locally for the user but not part of the repo's pipeline.
backfill_*.py
prune_*.py
run_batch.py
batch.txt
preview.ps1
preview.ps1.tmp.*
scripts/

# Audit / probe tools — they read the dataset but don't produce anything
# the map depends on. The pipeline code that does affect output
# (scrape_all.py, scrape_topup.py, map.py, transit_postprocess.py) is
# tracked normally.
src/tabelog/scrape/audit_*.py
src/tabelog/scrape/transit_audit.py

# Local rollback snapshots (e.g. map.py.bak before a big refactor)
*.bak

# Transit GeoJSON moved to Cloudflare R2 (assets.jpfoodmap.com). Stale
# region-specific extracts (okayama, etc.) likewise stay local — none are
# referenced by the build.
docs/transit/japan*.geojson
docs/transit/okayama.geojson

# Audit / implementation reports and screenshots (hundreds of MB) — kept
# local, never part of the deployed site.
audit_outputs/

# WSL venv symlink + stray root-level screenshots
.venv
/*.jpg
/*.png

# The build-contract checker IS part of the release gate — un-ignore it
# from the ad-hoc scripts/ rule above. fetch_vendor.py carries the sha256
# pins for everything in docs/vendor/ — it is the only record of where those
# bytes came from and the only way to re-fetch or upgrade them, so it ships
# with them (M-006 / M-011).
!scripts/
scripts/*
!scripts/verify_build.py
!scripts/verify_baseline.json
!scripts/fetch_vendor.py
